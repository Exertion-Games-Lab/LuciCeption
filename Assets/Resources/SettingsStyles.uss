.luci-reality--fullscreen {
  height: 100%;
  width: 100%
}

ui-content-container {
  flex-basis: 50%;
  flex-grow: 1;
  justify-content: center;
  align-self: center;
}

.nav-menu-link-container {
  background-color: #2B2B2B;
  margin-bottom: 8px;
  border-radius: 8px;
  flex-shrink: 1;
}

.nav-menu-button {
  margin: 4px;
}

.appui-navhost .appui-stackview {
  height: 100%;
}

.cue-settings-card {
    padding: 4px;
    flex-basis: 50%;
    flex-grow: 1;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: #2B2B2B;
}

.cue-settings-card-left {
    margin-right: 4px;
}

.cue-settings-card-right {
    margin-left: 4px;
}

.cue-module-row {
    flex-direction: row;
    margin-right: 0;
    /* padding-right: 8px; */
    /* padding-left: 8px; */
}

.cue-module-toggle {
    flex-direction: row-reverse;
}

.heading-row-container {
  flex-direction: row;
  justify-content: space-between;
}

.lucireality--file-browser {
  background-color: var(--appui-primary-200);
}

.content-text {
  font-size: 15px;
}

FileBrowser .unity-multi-column-view__header-container
{
  border-width: 0;
}

FileBrowser .unity-multi-column-header__column
{
  background-color: var(--appui-primary-300);
}

#audio-clip-selector {
  cursor: var(--appui-alias-control-cursor-pointer);
}

#audio-clip-selector #appui-textfield__input {
  cursor: var(--appui-alias-control-cursor-pointer);
}

#audio-clip-selector #unity-text-input {
  cursor: var(--appui-alias-control-cursor-pointer);
}

#audio-clip-selector TextElement {
  cursor: var(--appui-alias-control-cursor-pointer);
}