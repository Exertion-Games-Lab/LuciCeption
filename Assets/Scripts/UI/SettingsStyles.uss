.cue-settings-card {
    padding: 2px;
    flex-basis: 50%;
    flex-grow: 1;
    margin-bottom: 8px;
}

.cue-settings-card-left {
    margin-right: 4px;
}

.cue-settings-card-right {
    margin-left: 4px;
}

.cue-module-row {
    flex-direction: row;
    margin-right: 0;
    padding-right: 8px;
    padding-left: 8px;
}

.cue-module-toggle {
    flex-direction: row-reverse;
}
