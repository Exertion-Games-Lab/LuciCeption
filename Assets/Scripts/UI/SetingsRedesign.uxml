<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xsi="http://www.w3.org/2001/XMLSchema-instance" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/SettingsStyles.uss?fileID=7433441132597879392&amp;guid=d34b29af7d3936943bf9138b587a2290&amp;type=3#SettingsStyles" />
    <appui:Panel name="root-panel">
        <appui:Toolbar />
        <appui:SplitView fixed-pane-index="0" fixed-pane-initial-dimension="400" orientation="Horizontal">
            <appui:Pane class="section-prompts" style="width: 30%;">
                <appui:Heading text="Dream Prompt" />
                <appui:TextArea name="prompt-text" placeholder="What would you like to dream about?" leading-icon-name="info" />
                <appui:ActionButton name="prompt-submit-button" label="Submit" />
                <appui:Divider spacing="M" />
                <appui:Heading text="Image Generation" />
                <ui:VisualElement name="generated-image-box" style="height: 400px; background-color: rgb(153, 153, 153);" />
                <appui:ActionButton name="image-generate-button" label="Generate" />
            </appui:Pane>
            <appui:Pane stretch-factor="1" class="section-cues" style="width: 70%;">
                <appui:Heading text="Cue Modules" />
                <ui:VisualElement class="cue-module-row">
                    <appui:ExVisualElement class="appui-elevation-1 cue-settings-card cue-settings-card-left">
                        <appui:Heading text="Visual" size="S" />
                        <appui:InputLabel direction="Horizontal" label="Colour">
                            <appui:ColorPicker name="visual-cue-colour" size="S" show-alpha="false" hdr="false" value="#FF0000FF" show-hex="false" />
                        </appui:InputLabel>
                        <appui:InputLabel direction="Horizontal" label="Intensity">
                            <appui:SliderFloat name="visual-cue-intensity" size="S" filled="true" tick-count="10" inline-value="End" low-value="0" high-value="1" value="0.5" />
                        </appui:InputLabel>
                        <ui:VisualElement style="flex-grow: 1;" />
                        <appui:Toggle name="visual-cue-enabled" class="cue-module-toggle" />
                    </appui:ExVisualElement>
                    <appui:ExVisualElement class="appui-elevation-1 cue-settings-card cue-settings-card-right">
                        <appui:Heading text="Auditory" size="s" />
                        <appui:ActionGroup selection-type="Single" justified="true" compact="true">
                            <appui:ActionButton label="Ambient" />
                            <appui:ActionButton label="Generated Voice" />
                            <appui:ActionButton label="Clip" />
                        </appui:ActionGroup>
                        <appui:Dropdown size="M" />
                        <appui:InputLabel direction="Horizontal" label="Volume">
                            <appui:SliderFloat name="audio-cue-volume" size="S" filled="true" tick-count="10" inline-value="End" low-value="0" high-value="1" value="0.5" />
                        </appui:InputLabel>
                        <ui:VisualElement style="flex-grow: 1;" />
                        <appui:Toggle name="audio-cue-enabled" class="cue-module-toggle" />
                    </appui:ExVisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="cue-module-row">
                    <appui:ExVisualElement class="appui-elevation-1 cue-settings-card cue-settings-card-left">
                        <appui:Heading text="Haptic Vibrations" size="s" />
                        <appui:InputLabel direction="Horizontal" label="Intensity">
                            <appui:SliderFloat name="lra-cue-intensity" size="S" filled="true" tick-count="10" inline-value="End" low-value="0" high-value="1" value="0.5" />
                        </appui:InputLabel>
                        <ui:VisualElement style="flex-grow: 1;" />
                        <appui:Toggle name="lra-cue-enabled" class="cue-module-toggle" />
                    </appui:ExVisualElement>
                    <appui:ExVisualElement class="appui-elevation-1 cue-settings-card cue-settings-card-right">
                        <appui:Heading text="Fan" size="s" />
                        <appui:InputLabel direction="Horizontal" label="Intensity">
                            <appui:SliderFloat name="fan-cue-intensity" size="S" filled="true" tick-count="10" inline-value="End" low-value="0" high-value="1" value="0.5" />
                        </appui:InputLabel>
                        <ui:VisualElement style="flex-grow: 1;" />
                        <appui:Toggle name="fan-cue-enabled" class="cue-module-toggle" />
                    </appui:ExVisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="cue-module-row">
                    <appui:ExVisualElement class="appui-elevation-1 cue-settings-card cue-settings-card-left">
                        <appui:Heading text="EMS" size="s" />
                        <appui:InputLabel direction="Horizontal" label="Intensity">
                            <appui:SliderFloat name="ems-cue-intensity" size="S" filled="true" tick-count="10" inline-value="End" low-value="0" high-value="1" value="0.5" />
                        </appui:InputLabel>
                        <ui:VisualElement style="flex-grow: 1;" />
                        <appui:Toggle name="ems-cue-enabled" class="cue-module-toggle" />
                    </appui:ExVisualElement>
                    <appui:ExVisualElement class="appui-elevation-1 cue-settings-card cue-settings-card-right">
                        <appui:Heading text="Olfactory" size="s" />
                        <appui:ActionGroup selection-type="Single" justified="true" compact="true">
                            <appui:ActionButton label="Pleasant" />
                            <appui:ActionButton label="Unpleasant" />
                        </appui:ActionGroup>
                        <ui:VisualElement style="flex-grow: 1;" />
                        <appui:Toggle name="olfactory-cue-enabled" class="cue-module-toggle" />
                    </appui:ExVisualElement>
                </ui:VisualElement>
                <appui:ExVisualElement class="appui-elevation-1" style="flex-grow: 1; margin-left: 8px; margin-right: 8px; margin-bottom: 8px; padding: 2px;">
                    <appui:Heading text="System" />
                    <appui:ActionGroup>
                        <appui:Text text="Delay" />
                        <appui:IntField size="S" unit="h" />
                        <appui:Text text=":" />
                        <appui:IntField size="S" unit="m" />
                        <appui:Text text=":" />
                        <appui:IntField size="S" unit="s" />
                    </appui:ActionGroup>
                    <appui:ActionGroup>
                        <appui:Button title="Start System" variant="Accent" />
                        <appui:Button title="Test Cues" />
                    </appui:ActionGroup>
                </appui:ExVisualElement>
            </appui:Pane>
        </appui:SplitView>
    </appui:Panel>
</ui:UXML>
